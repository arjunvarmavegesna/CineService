generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  THEATER_ADMIN
  OPERATIONS_STAFF
  KITCHEN_STAFF
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum MenuItemStatus {
  AVAILABLE
  OUT_OF_STOCK
  HIDDEN
}

model User {
  id            String   @id @default(cuid())
  clerkId       String?  @unique
  name          String?
  email         String?  @unique
  phone         String?  @unique
  role          Role     @default(CUSTOMER)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]
}

model Theater {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  address   String
  city      String
  state     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  screens   Screen[]
  menuItems MenuItem[]
  orders    Order[]
}

model Screen {
  id        String   @id @default(cuid())
  theaterId String
  name      String
  number    Int
  capacity  Int
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  theater   Theater  @relation(fields: [theaterId], references: [id])
  seats     Seat[]
  orders    Order[]
}

model Seat {
  id       String   @id @default(cuid())
  screenId String
  row      String
  number   Int
  label    String
  isActive Boolean  @default(true)
  createdAt DateTime @default(now())
  screen   Screen   @relation(fields: [screenId], references: [id])
  orders   Order[]

  @@unique([screenId, row, number])
}

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  menuItems MenuItem[]
}

model MenuItem {
  id          String         @id @default(cuid())
  categoryId  String
  theaterId   String?
  name        String
  description String?
  imageUrl    String?
  basePrice   Float
  isVeg       Boolean        @default(true)
  status      MenuItemStatus @default(AVAILABLE)
  isFeatured  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  category    Category       @relation(fields: [categoryId], references: [id])
  theater     Theater?       @relation(fields: [theaterId], references: [id])
  orderItems  OrderItem[]
}

model Order {
  id          String      @id @default(cuid())
  orderNumber String      @unique
  userId      String?
  theaterId   String
  screenId    String
  seatId      String
  seatLabel   String
  status      OrderStatus @default(PENDING)
  subtotal    Float
  taxAmount   Float       @default(0)
  totalAmount Float
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User?       @relation(fields: [userId], references: [id])
  theater     Theater     @relation(fields: [theaterId], references: [id])
  screen      Screen      @relation(fields: [screenId], references: [id])
  seat        Seat        @relation(fields: [seatId], references: [id])
  items       OrderItem[]
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  menuItemId String
  quantity   Int
  unitPrice  Float
  totalPrice Float
  name       String
  order      Order    @relation(fields: [orderId], references: [id])
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
}